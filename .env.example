# ============================================================
# FRONTEND ENVIRONMENT VARIABLES - Vite React
# ============================================================
# Copier ce fichier en .env.local pour le développement
# cp .env.example .env.local

# ------------------------------------------------------------
# PLATEFORME DE DÉPLOIEMENT (badge affiché dans la navbar)
# Valeurs possibles : ec2 | beanstalk | ecs | eks | (vide)
# ------------------------------------------------------------
# VITE_DEPLOY_PLATFORM=ec2
# VITE_DEPLOY_PLATFORM=beanstalk
# VITE_DEPLOY_PLATFORM=ecs
# VITE_DEPLOY_PLATFORM=eks

# ------------------------------------------------------------
# BACKEND API
# Le frontend utilise des chemins relatifs (/api/...)
# NGINX proxifie vers le bon backend selon l'environnement.
#
# Exemples par environnement :
#
# Dev local (monolithe)    → NGINX proxy vers http://localhost:3000
# Dev local (microservices)→ NGINX proxy vers http://localhost:30080
# EKS + ALB               → NGINX proxy vers http://<ALB_DNS>
# Beanstalk / ECS         → NGINX proxy via Dockerrun.aws.json
# ------------------------------------------------------------
# VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------
# NOTES
# - Les variables VITE_* sont embarquées dans le build (public)
# - Ne jamais mettre de secrets ici
# - Pour la prod, définir dans le script user data EC2,
#   les env vars Beanstalk, ou les variables ECS Task Definition
# ------------------------------------------------------------
